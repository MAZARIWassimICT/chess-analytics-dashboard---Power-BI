			lineageTag: 1568ab79-b431-40ca-9f8b-dbd721a05ff2
			column: 'games_played _as_black'

	partition player = m
		mode: import
		source =
				let
				    Source = Table.NestedJoin(P1, {"white_id"}, P2, {"black_id"}, "Players (2)", JoinKind.FullOuter),
				    #"Expanded Players (2)" = Table.ExpandTableColumn(Source, "Players (2)", {"black_id", "games_played _as_black"}, {"black_id", "games_played _as_black"}),
