table player
	lineageTag: 8b939368-2ead-463d-af6e-a49d9ebad151

	measure 'Games as White' =
			
			VAR SelectedPlayer = VALUES(player[player_id])
			RETURN
			    CALCULATE(
			        COUNTROWS(chess_games),
			        FILTER(
			            chess_games,
			            chess_games[white_id] IN SelectedPlayer
			        )
			    )
		formatString: 0
		lineageTag: 4cd50d0f-eaa0-458e-9f89-bf131c945b0c

	measure 'Games as Black' =
			
			VAR SelectedPlayer = VALUES(player[player_id])
			RETURN
			    CALCULATE(
			        COUNTROWS(chess_games),
			        FILTER(
			            chess_games,
			            chess_games[black_id] IN SelectedPlayer
			        )
			    )
		formatString: 0
		lineageTag: 172d952e-6db2-43f3-96ec-40e1ed0bcc42

	column player_id
		dataType: string
		lineageTag: 3059c0eb-807e-4ec1-9956-ba92ed9aa48e
		summarizeBy: none
		sourceColumn: player_id

		annotation SummarizationSetBy = Automatic

	column total_games
