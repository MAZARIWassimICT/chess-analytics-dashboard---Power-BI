	measure 'Corr Time_Turns' = ```
			
			// 1. Calculate overall averages for the dataset
			VAR __muTime = CALCULATE(AVERAGE('chess_games'[time_without_increment (min)]))
			VAR __muTurns = CALCULATE(AVERAGE('chess_games'[turns]))
			
			// 2. Calculate the numerator (sum of multiplied variances)
			VAR __numerator = 
			    SUMX(
			        'chess_games', 
			        ('chess_games'[time_without_increment (min)] - __muTime) * ('chess_games'[turns] - __muTurns)
			    )
			
			// 3. Calculate the denominator (square root of squared variances)
			VAR __denominator = 
			    SQRT(
			        SUMX('chess_games', ('chess_games'[time_without_increment (min)] - __muTime)^2) * 
			        SUMX('chess_games', ('chess_games'[turns] - __muTurns)^2)
			    )
			
			// 4. Return the divided result
			RETURN 
			    DIVIDE(__numerator, __denominator)
			```
		lineageTag: 4145e73c-d205-47cd-9e76-aa2e664f6096

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Corr Increment_Turns' = ```
			
			// 1. Calculate overall averages
			VAR __muInc = CALCULATE(AVERAGE('chess_games'[increment (s)]))
			VAR __muTurns = CALCULATE(AVERAGE('chess_games'[turns]))
			
			// 2. Calculate the numerator
			VAR __numerator = 
			    SUMX(
			        'chess_games', 
			        ('chess_games'[increment (s)] - __muInc) * ('chess_games'[turns] - __muTurns)
			    )
			
			// 3. Calculate the denominator
			VAR __denominator = 
			    SQRT(
			        SUMX('chess_games', ('chess_games'[increment (s)] - __muInc)^2) * 
			        SUMX('chess_games', ('chess_games'[turns] - __muTurns)^2)
			    )
			
			// 4. Return the result
			RETURN 
			    DIVIDE(__numerator, __denominator)
			```
		lineageTag: dc14b5ab-b42f-4421-bda4-f9b0686bb82e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Correlation_Time_Increment_Mins = ```
			
			// 1. Calculate overall averages (converting average increment to minutes)
			VAR __muTime = CALCULATE(AVERAGE('chess_games'[time_without_increment (min)]))
			VAR __muInc_Min = CALCULATE(AVERAGE('chess_games'[increment (s)])) / 60
			
			// 2. Calculate the numerator
			VAR __numerator = 
			    SUMX(
			        'chess_games', 
			        ('chess_games'[time_without_increment (min)] - __muTime) * (('chess_games'[increment (s)] / 60) - __muInc_Min)
			    )
			
			// 3. Calculate the denominator
			VAR __denominator = 
			    SQRT(
			        SUMX('chess_games', ('chess_games'[time_without_increment (min)] - __muTime)^2) * 
			        SUMX('chess_games', (('chess_games'[increment (s)] / 60) - __muInc_Min)^2)
			    )
			
			// 4. Return the result
			RETURN 
			    DIVIDE(__numerator, __denominator)
			```
		lineageTag: 4d5ade56-1c86-491d-bcf3-740162cba328

		annotation PBI_FormatHint = {"isGeneralNumber":true}

