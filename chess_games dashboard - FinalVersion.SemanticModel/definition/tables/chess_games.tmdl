	measure 'Min Rating' = MIN(MIN(chess_games[black_rating]),MIN(chess_games[white_rating]))
		formatString: 0
		lineageTag: 7995e568-bba3-4d2b-90f9-38fbdd6086cb

	measure 'QG Games' =
			
			CALCULATE(
			    COUNTROWS(chess_games),
			    chess_games[opening_shortname] = "Queen's Gambit"
			)
		formatString: 0
		lineageTag: f7d0bd02-181e-4abb-8759-5a7248b1b32a

	measure 'QG Wins' =
			
			CALCULATE(
			    DISTINCTCOUNT(chess_games[game_id]),
			    chess_games[opening_shortname] = "Queen's Gambit",
			    chess_games[winner] = "white"
			)
		formatString: 0
		lineageTag: b07a74d2-478a-4398-bc0b-0840989ad648

	measure 'KG Wins' =
			
			CALCULATE(
			    DISTINCTCOUNT(chess_games[game_id]),
			    chess_games[opening_shortname] = "king's Gambit",
			    chess_games[winner] = "white"
			)
		formatString: 0
		lineageTag: 57870791-0277-47b0-8a68-b795d5d148f6

	measure 'EG Wins' =
			
